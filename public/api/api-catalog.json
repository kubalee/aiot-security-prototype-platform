{
  "apis": [
    {
      "id": "dashboard-overview",
      "group": "backend",
      "method": "GET",
      "path": "/api/dashboard.json",
      "name": "指挥看板汇总",
      "payload": {
        "zone": "string",
        "from": "datetime",
        "to": "datetime"
      }
    },
    {
      "id": "video-streams",
      "group": "backend",
      "method": "GET",
      "path": "/api/video-streams.json",
      "name": "视频流配置",
      "payload": {
        "enabledOnly": "boolean"
      }
    },
    {
      "id": "event-ingest",
      "group": "backend",
      "method": "POST",
      "path": "/api/security/events/ingest",
      "name": "AI 设备事件上报",
      "payload": {
        "deviceId": "string",
        "cameraId": "string",
        "eventType": "string",
        "confidence": "number",
        "frameUrl": "string",
        "metadata": "object"
      }
    },
    {
      "id": "event-detail",
      "group": "backend",
      "method": "GET",
      "path": "/api/security/events/{eventId}",
      "name": "事件详情",
      "payload": {
        "eventId": "string",
        "includeLogs": "boolean"
      }
    },
    {
      "id": "iot-command",
      "group": "backend",
      "method": "POST",
      "path": "/api/iot/linkage/commands",
      "name": "物联系统联动指令",
      "payload": {
        "eventId": "string",
        "commands": "array"
      }
    },
    {
      "id": "notification-task",
      "group": "backend",
      "method": "POST",
      "path": "/api/notification/tasks",
      "name": "人员通知任务",
      "payload": {
        "eventId": "string",
        "recipients": "array",
        "channels": "array",
        "escalationPolicy": "object"
      }
    },
    {
      "id": "notification-receipts",
      "group": "backend",
      "method": "GET",
      "path": "/api/notification/tasks/{taskId}/receipts",
      "name": "通知回执查询",
      "payload": {
        "taskId": "string"
      }
    },
    {
      "id": "contacts",
      "group": "backend",
      "method": "GET",
      "path": "/api/security/contacts",
      "name": "应急联系人",
      "payload": {
        "zone": "string",
        "role": "string",
        "onDuty": "boolean"
      }
    },
    {
      "id": "audit-logs",
      "group": "backend",
      "method": "POST",
      "path": "/api/security/audit-logs",
      "name": "处置审计日志",
      "payload": {
        "eventId": "string",
        "actor": "string",
        "action": "string",
        "payload": "object"
      }
    },
    {
      "id": "api-catalog",
      "group": "backend",
      "method": "GET",
      "path": "/api/api-catalog.json",
      "name": "接口目录",
      "payload": {}
    },
    {
      "id": "agent-vision",
      "group": "agent",
      "method": "POST",
      "path": "/agents/vision-reviewer/invoke",
      "name": "视觉复核智能体",
      "payload": {
        "eventId": "string",
        "streamId": "string",
        "frameWindow": "object",
        "detectionBoxes": "array"
      }
    },
    {
      "id": "agent-risk",
      "group": "agent",
      "method": "POST",
      "path": "/agents/risk-assessor/invoke",
      "name": "风险研判智能体",
      "payload": {
        "event": "object",
        "sensorReadings": "array",
        "historicalContext": "object"
      }
    },
    {
      "id": "agent-plan",
      "group": "agent",
      "method": "POST",
      "path": "/agents/response-planner/invoke",
      "name": "处置方案智能体",
      "payload": {
        "riskLevel": "string",
        "zone": "string",
        "availableDevices": "array",
        "contacts": "array"
      }
    }
  ]
}
